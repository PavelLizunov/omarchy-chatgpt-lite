+//! Bounded, atomic persistence of the public jar. Private browsing never writes it.
+use std::fs;
+use std::io::{self, Write};
+use std::os::unix::fs::{MetadataExt, PermissionsExt};
+use std::path::{Path, PathBuf};
+use std::sync::{Arc, atomic::{AtomicBool, Ordering}};
+use std::thread::{self, JoinHandle};
+use std::time::Duration;
+
+use crate::http_loader::HttpState;
+
+pub(crate) fn atomic_write(directory: &Path, bytes: &[u8]) -> io::Result<()> {
+    let metadata = fs::symlink_metadata(directory)?;
+    if !metadata.is_dir() || metadata.mode() & 0o777 != 0o700 ||
+        metadata.uid() != fs::metadata("/proc/self")?.uid() {
+        return Err(io::ErrorKind::PermissionDenied.into());
+    }
+    let target = directory.join("cookie_jar.json");
+    match fs::symlink_metadata(&target) {
+        Ok(m) if !m.is_file() || m.uid() != metadata.uid() =>
+            return Err(io::ErrorKind::PermissionDenied.into()),
+        Err(e) if e.kind() != io::ErrorKind::NotFound => return Err(e),
+        _ => {},
+    }
+    let mut temporary = tempfile::NamedTempFile::new_in(directory)?;
+    temporary.as_file().set_permissions(fs::Permissions::from_mode(0o600))?;
+    temporary.write_all(bytes)?;
+    temporary.as_file().sync_all()?;
+    temporary.persist(&target).map_err(|e| e.error)?;
+    fs::File::open(directory)?.sync_all()
+}
+
+pub(crate) struct CookieCheckpoint {
+    stop: Arc<AtomicBool>,
+    worker: Option<JoinHandle<()>>,
+}
+impl CookieCheckpoint {
+    pub(crate) fn start(directory: Option<PathBuf>, public: Arc<HttpState>) -> Self {
+        let stop = Arc::new(AtomicBool::new(false));
+        let flag = stop.clone();
+        let worker = directory.and_then(|directory| thread::Builder::new()
+            .name("cookie-checkpoint".into()).spawn(move || {
+                let mut saved = Vec::new();
+                loop {
+                    // Hold the read lock through the atomic replacement: no stale writer race.
+                    let jar = public.cookie_jar.read();
+                    match serde_json::to_vec_pretty(&*jar) {
+                        Ok(bytes) if bytes != saved => {
+                            if atomic_write(&directory, &bytes).is_ok() {
+                                saved = bytes;
+                            } else {
+                                log::warn!("COOKIE_CHECKPOINT_FAILED");
+                            }
+                        },
+                        Err(_) => log::warn!("COOKIE_CHECKPOINT_SERIALIZE_FAILED"),
+                        _ => {},
+                    }
+                    drop(jar);
+                    if flag.load(Ordering::Acquire) { break; }
+                    thread::park_timeout(Duration::from_secs(2));
+                }
+            }).ok());
+        Self { stop, worker }
+    }
+}
+impl Drop for CookieCheckpoint {
+    fn drop(&mut self) {
+        self.stop.store(true, Ordering::Release);
+        if let Some(worker) = self.worker.take() {
+            worker.thread().unpark();
+            let _ = worker.join();
+        }
+    }
+}
