+//! Experimental native frame/input transport. No browser screenshots or DOM scraping.
+use std::io::{Read, Write};
+use std::os::unix::fs::PermissionsExt;
+use std::os::unix::net::UnixListener;
+use std::sync::{OnceLock, Mutex, mpsc};
+use std::time::Duration;
+use servo::{EventLoopWaker, InputEvent, WebView};
+use serde::Deserialize;
+
+#[derive(Deserialize)]
+#[serde(tag = "type", deny_unknown_fields)]
+pub enum Command {
+    Input { event: InputEvent },
+    Focus { focused: bool },
+    Resize { width: u32, height: u32 },
+    Reload,
+    Shutdown,
+}
+pub struct Bridge {
+    frames: mpsc::SyncSender<Vec<u8>>,
+    commands: Mutex<mpsc::Receiver<Command>>,
+}
+static BRIDGE: OnceLock<Bridge> = OnceLock::new();
+
+pub fn start(waker: Box<dyn EventLoopWaker>) -> std::io::Result<()> {
+    let Some(path) = std::env::var_os("CHATGPT_SERVO_NATIVE_SOCKET") else { return Ok(()); };
+    let path = std::path::PathBuf::from(path);
+    if !path.is_absolute() || path.exists() { return Err(std::io::ErrorKind::InvalidInput.into()); }
+    let parent = path.parent().ok_or(std::io::ErrorKind::InvalidInput)?;
+    let metadata = std::fs::symlink_metadata(parent)?;
+    use std::os::unix::fs::MetadataExt;
+    if !metadata.is_dir() || metadata.mode() & 0o777 != 0o700 || metadata.uid() != unsafe { libc::getuid() } {
+        return Err(std::io::ErrorKind::PermissionDenied.into());
+    }
+    let listener = UnixListener::bind(&path)?;
+    std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o600))?;
+    let (frame_tx, frame_rx) = mpsc::sync_channel::<Vec<u8>>(1);
+    let (command_tx, command_rx) = mpsc::sync_channel::<Command>(64);
+    if BRIDGE.set(Bridge { frames: frame_tx, commands: Mutex::new(command_rx) }).is_err() {
+        return Err(std::io::ErrorKind::AlreadyExists.into());
+    }
+    std::thread::Builder::new().name("native-transport".into()).spawn(move || {
+        // The owned service/cgroup bounds lifetime. One private connection; no retries.
+        let Ok((mut output, _)) = listener.accept() else { return; };
+        drop(listener);
+        let _ = std::fs::remove_file(path);
+        let Ok(mut input) = output.try_clone() else { return; };
+        let _ = output.set_write_timeout(Some(Duration::from_millis(500)));
+        std::thread::spawn(move || {
+            loop {
+                let mut length = [0u8; 4];
+                if input.read_exact(&mut length).is_err() { break; }
+                let length = u32::from_be_bytes(length) as usize;
+                if length == 0 || length > 16384 { break; }
+                let mut bytes = vec![0; length];
+                if input.read_exact(&mut bytes).is_err() { break; }
+                let command = match serde_json::from_slice::<Command>(&bytes) {
+                    Ok(command) => command,
+                    Err(_) => { eprintln!("NATIVE_INPUT_PARSE_FAILED"); break; }
+                };
+                if command_tx.try_send(command).is_err() { break; }
+                waker.wake();
+            }
+            // Loss of the sole owned consumer must not leave an orphan engine.
+            let _ = command_tx.try_send(Command::Shutdown);
+            waker.wake();
+        });
+        while let Ok(frame) = frame_rx.recv() {
+            if output.write_all(&frame).is_err() { break; }
+        }
+    })?;
+    Ok(())
+}
+
+pub fn dispatch(state: &crate::running_app_state::RunningAppState, window: &crate::window::ServoShellWindow, webview: &WebView) {
+    let Some(bridge) = BRIDGE.get() else { return; };
+    let Ok(commands) = bridge.commands.lock() else { return; };
+    for _ in 0..64 {
+        let Ok(command) = commands.try_recv() else { break; };
+        match command {
+            Command::Input { event } => { webview.notify_input_event(event); },
+            Command::Focus { focused } => webview.set_focused(focused),
+            Command::Resize { width, height } if (100..=2048).contains(&width) && (100..=2048).contains(&height) => {
+                let size = servo::DeviceIntSize::new(width as i32, height as i32);
+                window.platform_window().request_resize(webview, size);
+                window.platform_window().rendering_context().resize(dpi::PhysicalSize::new(width, height));
+            },
+            Command::Resize { .. } => {},
+            Command::Reload => webview.reload(),
+            Command::Shutdown => state.schedule_exit(),
+        }
+    }
+}
+
+pub fn frame(context: &dyn servo::RenderingContext) {
+    let Some(bridge) = BRIDGE.get() else { return; };
+    let size = context.size();
+    if size.width == 0 || size.height == 0 || size.width > 2048 || size.height > 2048 { return; }
+    let rectangle = servo::DeviceIntRect::from_origin_and_size(
+        servo::DeviceIntPoint::zero(), servo::DeviceIntSize::new(size.width as i32, size.height as i32));
+    let Some(image) = context.read_to_image(rectangle) else { return; };
+    let pixels = image.into_raw();
+    if pixels.len() != size.width as usize * size.height as usize * 4 { return; }
+    let mut packet = Vec::with_capacity(16 + pixels.len());
+    packet.extend_from_slice(b"SV01");
+    packet.extend_from_slice(&size.width.to_be_bytes());
+    packet.extend_from_slice(&size.height.to_be_bytes());
+    packet.extend_from_slice(&(pixels.len() as u32).to_be_bytes());
+    packet.extend_from_slice(&pixels);
+    let _ = bridge.frames.try_send(packet); // One pending frame; drop stale visual updates.
+}
